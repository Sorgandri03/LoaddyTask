    "required": ["name", "language", "weight"],
    "properties": {
      "name": {
        "type": "string"
      },
      "language": {
        "type": "string"
      },
      "weight": {
        "type": "integer",
        "minimum": 0
      }
    },
    "additionalProperties": false
  }
}